# ==========================================
# Study Arena Frontend Environment Variables
# ==========================================

# Option 1: Single unified Ngrok URL (Recommended for ngrok testing)
# Paste your Django backend ngrok URL here:
VITE_NGROK_URL=https://your-backend-subdomain.ngrok-free.app

# Option 2: Separate API and WebSocket URLs (Optional)
# VITE_API_URL=https://your-backend-subdomain.ngrok-free.app
# VITE_WS_URL=wss://your-backend-subdomain.ngrok-free.app
